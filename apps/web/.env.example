# Copy to `.env.local` and fill in from Supabase → Project Settings → API.
# Only the PUBLIC (anon / publishable) key belongs here. Never put the
# service-role key in any frontend environment file.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public URL of this web app, used in auth email redirects and invitation links.
VITE_APP_URL=http://localhost:5173
